# Copy to .env and fill with long random values (letters and digits only):
#   openssl rand -hex 24
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Emails allowed to open the platform owner console (comma-separated)
PLATFORM_ADMINS=
# 32-byte key that encrypts stored secrets (WhatsApp/SMS tokens, router passwords): openssl rand -hex 32
# Keep a copy in a safe place: without it the stored secrets cannot be decrypted.
APP_SECRET_KEY=
# Allow MikroTik routers on private/loopback addresses (only if the server reaches them over a VPN)
ALLOW_PRIVATE_ROUTERS=false
# Optional: where organisations pay their Paxve plan (shown on "My Paxve subscription"; renewal requests go to this phone)
PAXVE_SALES_PHONE=
PAXVE_SALES_EMAIL=
# Optional: AI assistant and supplier-bill reading. A Claude API key from console.anthropic.com (keep it secret; never commit it).
# Empty = the AI features stay off. PAXVE_AI_MODEL defaults to claude-opus-5-5.
PAXVE_ANTHROPIC_API_KEY=
PAXVE_AI_MODEL=
