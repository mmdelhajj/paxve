# Copy to .env and fill with long random values (letters and digits only):
#   openssl rand -hex 24
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Emails allowed to open the platform owner console (comma-separated)
PLATFORM_ADMINS=
# 32-byte key that encrypts stored secrets (WhatsApp/SMS tokens, router passwords): openssl rand -hex 32
# Keep a copy in a safe place: without it the stored secrets cannot be decrypted.
APP_SECRET_KEY=
# Allow MikroTik routers on private/loopback addresses (only if the server reaches them over a VPN)
ALLOW_PRIVATE_ROUTERS=false
