{
	servers {
		# Only Cloudflare may tell us the visitor's IP (CF-Connecting-IP); anyone else gets their socket address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

paxve.com, www.paxve.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Android app download (built by mobile/build-apk.sh into ./downloads; not in git)
	handle_path /download/* {
		root * /srv/downloads
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition "attachment; filename=\"paxve.apk\""
		header @apk Cache-Control "no-cache"
		# latest APK version, read by the app to offer updates
		@ver path /version.json
		header @ver Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy app:8080 {
			# the app trusts only this header for the client IP
			header_up X-Client-IP {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Forwarded-For
		}
	}
}
