#!/usr/bin/env bash
# Daily PostgreSQL backup for Paxve (installed as /usr/local/bin/paxve-backup, run by /etc/cron.d/paxve-backup).
# - dumps are encrypted (AES-256, gpg symmetric) with the passphrase in /srv/paxve-secrets/backup-passphrase;
#   keep a copy of that file off the server, without it the dumps cannot be read
# - 14 days are kept on this disk
# - off-server copy: when /srv/paxve-secrets/offsite.env sets RCLONE_REMOTE (e.g. "b2:paxve-backups") and rclone is
#   installed with its config in /srv/paxve-secrets/rclone.conf, each dump is also copied there
set -euo pipefail
cd /srv/paxve
umask 077
secrets=/srv/paxve-secrets
pass="$secrets/backup-passphrase"
if [ ! -s "$pass" ]; then
  head -c 48 /dev/urandom | base64 | tr -d '\n' > "$pass"
  chmod 600 "$pass"
fi
mkdir -p /srv/backups
ts=$(date +%Y%m%d-%H%M)
out=/srv/backups/paxve-$ts.dump.gpg
docker compose exec -T db pg_dump -U paxve -d paxve -Fc </dev/null |
  gpg --batch --yes --quiet --pinentry-mode loopback --symmetric --cipher-algo AES256 --passphrase-file "$pass" -o "$out"
test -s "$out"
echo "$(basename "$out")"
find /srv/backups -name 'paxve-*.dump*' -mtime +14 -delete

if [ -f "$secrets/offsite.env" ]; then
  # shellcheck disable=SC1091
  . "$secrets/offsite.env"
  if [ -n "${RCLONE_REMOTE:-}" ] && command -v rclone >/dev/null; then
    rclone --config "$secrets/rclone.conf" copy "$out" "$RCLONE_REMOTE" && echo "offsite: copied to $RCLONE_REMOTE"
  else
    echo "offsite: not configured (RCLONE_REMOTE / rclone missing)"
  fi
fi
